# Rendify local development variables. Copy this file to .env and edit it.
# NEVER commit .env. Use a real token only in that local file.
DENUE_API_TOKEN=
RENDIFY_CODE_VERSION=local

# Airflow 3 local-development setup (not production).
# On Linux, set AIRFLOW_UID to the output of: id -u
AIRFLOW_UID=50000
AIRFLOW_PROJ_DIR=.
ENV_FILE_PATH=.env
AIRFLOW_IMAGE_NAME=apache/airflow:3.3.2-python3.12
FERNET_KEY=
AIRFLOW__API_AUTH__JWT_SECRET=local-dev-secret-change-me
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow

# Used when running scripts outside Docker; Compose overrides these inside Airflow.
RENDIFY_DATA_DIR=data
RENDIFY_REPORTS_DIR=reports/generated
